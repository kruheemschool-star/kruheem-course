ve Numbers\",\n        \"Addition\"\n      ],\n      \"tag_th\": [\n        \"จำนวนลบ\",\n        \"การบวก\"\n      ]\n    }\n  },\n  {\n    \"id\": 23,\n    \"question\": \"ผลบวกของ $(-13) + (-19)$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$-6$\",\n      \"$-30$\",\n      \"$-32$\",\n      \"$-42$\"\n    ],\n    \"answerIndex\": 2,\n    \"explanation\": {\n      \"principle\": \"พวกเดียวกัน (ทีมลบ) เมื่อมาเจอกัน พลังจะรวมกันและยังคงเป็นทีมเดิม (ติดลบมากขึ้น)\",\n      \"steps\": [\n        \"ตั้งหลักบวกเลข: $13 + 19$\",\n        \"หลักหน่วย: $3 + 9 = 12$ (ใส่ 2 ทด 1)\",\n        \"หลักสิบ: $1 + 1 + 1 (ตัวทด) = 3$\",\n        \"ได้ผลรวมคือ 32 แต่ต้องใส่เครื่องหมายลบตามเดิม\",\n        \"คำตอบคือ **-32** ครับ ✅\"\n      ],\n      \"pitfall\": \"อย่าเผลอเอา 19 ลบ 13 แล้วตอบ -6 นะครับ จำไว้ว่าเครื่องหมายเหมือนกันคือ 'การสะสม' ต้องเพิ่มขึ้นเสมอ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Easy\",\n      \"tag_en\": [\n        \"Negative Numbers\",\n        \"Addition\"\n      ],\n      \"tag_th\": [\n        \"จำนวนลบ\",\n        \"การบวก\"\n      ]\n    }\n  },\n  {\n    \"id\": 24,\n    \"question\": \"ค่าของ $(-25) + (-48)$ เท่ากับข้อใด ?\",\n    \"options\": [\n      \"$-63$\",\n      \"$-73$\",\n      \"$-83$\",\n      \"$-23$\"\n    ],\n    \"answerIndex\": 1,\n    \"explanation\": {\n      \"principle\": \"การบวกจำนวนลบสองจำนวน คือการนำค่าสัมบูรณ์มารวมกันแล้วตอบเป็นจำนวนลบ\",\n      \"steps\": [\n        \"มองเป็นตัวเลขธรรมดา: $25 + 48$\",\n        \"บวกหลักหน่วย: $5 + 8 = 13$ (ใส่ 3 ทด 1)\",\n        \"บวกหลักสิบ: $2 + 4 + 1 (ตัวทด) = 7$\",\n        \"รวมร่างกันได้ 73\",\n        \"ใส่เครื่องหมายลบกลับไป ได้เป็น **-73** ครับ ✅\"\n      ],\n      \"pitfall\": \"จุดที่ผิดบ่อยคือการลืมตัวทด หรือบวกลบเลขผิดหลักครับ ต้องรอบคอบนิดนึงนะ!\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Negative Numbers\",\n        \"Calculation\"\n      ],\n      \"tag_th\": [\n        \"จำนวนลบ\",\n        \"การคำนวณ\"\n      ]\n    }\n  },\n  {\n    \"id\": 25,\n    \"question\": \"ผลลัพธ์ของ $(-56) + (-92)$ คือข้อใด ?\",\n    \"options\": [\n      \"$-138$\",\n      \"$-148$\",\n      \"$-158$\",\n      \"$-36$\"\n    ],\n    \"answerIndex\": 1,\n    \"explanation\": {\n      \"principle\": \"คอนเซปต์เดิม: หนี้ก้อนใหญ่ + หนี้ก้อนใหญ่ = หนี้ก้อนมึหึมา! (นำตัวเลขมารวมกัน)\",\n      \"steps\": [\n        \"จับตัวเลขมาบวกกันเลย: $56 + 92$\",\n        \"หลักหน่วย: $6 + 2 = 8$\",\n        \"หลักสิบ: $5 + 9 = 14$\",\n        \"รวมกันได้ 148\",\n        \"อย่าลืมแปะป้าย 'ติดลบ' ไว้ข้างหน้าด้วยนะ ตอบ **-148** ครับ ✅\"\n      ],\n      \"pitfall\": \"ระวังตัวเลือกหลอกที่เป็นผลต่าง (-36) หรือการบวกผิด (138, 158) เช็คตัวเลขให้ชัวร์ก่อนกาข้อสอบครับ!\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Negative Numbers\",\n        \"Large Numbers\"\n      ],\n      \"tag_th\": [\n        \"จำนวนลบ\",\n        \"จำนวนค่ามาก\"\n      ]\n    }\n  },\n  {\n    \"id\": 26,\n    \"question\": \"ผลบวกของ $(-35) + (-142)$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$-107$\",\n      \"$-177$\",\n      \"$-187$\",\n      \"$-167$\"\n    ],\n    \"answerIndex\": 1,\n    \"explanation\": {\n      \"principle\": \"การบวกจำนวนเต็มลบกับจำนวนเต็มลบ ให้นำค่าสัมบูรณ์ (ตัวเลข) มาบวกกัน แล้วตอบเป็นจำนวนเต็มลบครับ (รวมหนี้ก้อนใหญ่)\",\n      \"steps\": [\n        \"ตั้งหลักบวกเลข: $35 + 142$\",\n        \"หลักหน่วย: $5 + 2 = 7$\",\n        \"หลักสิบ: $3 + 4 = 7$\",\n        \"หลักร้อย: $1$\",\n        \"รวมได้ $177$ แต่ต้องใส่เครื่องหมายลบข้างหน้า\",\n        \"คำตอบคือ **-177** ครับ ✅\"\n      ],\n      \"pitfall\": \"ระวังการบวกลบเลขผิดหลัก หรือเผลอนำตัวเลขมาลบกันเพราะเห็นเครื่องหมายต่างกัน (ในข้อนี้เครื่องหมายเหมือนกันคือลบกับลบ ต้องเอามาบวกกันนะครับ)\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Negative Numbers\",\n        \"Large Integers\"\n      ],\n      \"tag_th\": [\n        \"จำนวนลบ\",\n        \"จำนวนเต็มค่ามาก\"\n      ]\n    }\n  },\n  {\n    \"id\": 27,\n    \"question\": \"ผลบวกของ $(-59) + (-213)$ เท่ากับเท่าไร ?\",\n    \"options\": [\n      \"$-262$\",\n      \"$-154$\",\n      \"$-272$\",\n      \"$-282$\"\n    ],\n    \"answerIndex\": 2,\n    \"explanation\": {\n      \"principle\": \"คอนเซปต์เดิมครับ: 'ลบ' บวก 'ลบ' ได้ 'ลบที่เยอะขึ้น' (หนี้ก้อนโตขึ้น)\",\n      \"steps\": [\n        \"นำตัวเลขมาบวกกัน: $59 + 213$\",\n        \"หลักหน่วย: $9 + 3 = 12$ (ใส่ 2 ทด 1)\",\n        \"หลักสิบ: $5 + 1 + 1 (ตัวทด) = 7$\",\n        \"หลักร้อย: $2$\",\n        \"รวมร่างเป็น $272$ แล้วใส่เครื่องหมายลบ\",\n        \"ตอบ **-272** ครับ ✅\"\n      ],\n      \"pitfall\": \"ข้อนี้มีตัวทดด้วยนะ! ระวังลืมทดเลขในหลักสิบครับ และอย่าเผลอตอบเป็นค่าบวกเด็ดขาด\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Negative Numbers\",\n        \"Calculation\"\n      ],\n      \"tag_th\": [\n        \"จำนวนลบ\",\n        \"การคำนวณ\"\n      ]\n    }\n  },\n  {\n    \"id\": 28,\n    \"question\": \"ผลบวกของ $(15 + 9) + (-12)$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$12$\",\n      \"$36$\",\n      \"$-12$\",\n      \"$0$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"การบวกจำนวนเต็มสามจำนวนที่มีวงเล็บ ให้ทำในวงเล็บก่อนเสมอครับ (Order of Operations)\",\n      \"steps\": [\n        \"ขั้นที่ 1: ทำในวงเล็บ $(15 + 9)$\",\n        \"   $15 + 9 = 24$ (ได้จำนวนเต็มบวก)\",\n        \"ขั้นที่ 2: นำผลลัพธ์ไปบวกกับตัวที่เหลือ\",\n        \"   $24 + (-12)$\",\n        \"   นี่คือการบวกจำนวนต่างชนิดกัน (มีเงิน 24 บาท ใช้หนี้ไป 12 บาท)\",\n        \"   ให้นำตัวเลขมาลบกัน: $24 - 12 = 12$\",\n        \"   เงินเหลือมากกว่าหนี้ ดังนั้นคำตอบเป็นบวก\",\n        \"ตอบ **12** ครับ ✅\"\n      ],\n      \"pitfall\": \"ระวังขั้นที่ 2 ครับ การบวกด้วยจำนวนลบ คือการลบออก อย่าเผลอเอา 24 ไปบวก 12 เป็น 36 นะครับ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Grouping Symbols\",\n        \"Mixed Operations\"\n      ],\n      \"tag_th\": [\n        \"เครื่องหมายจัดกลุ่ม\",\n        \"การดำเนินการระคน\"\n      ]\n    }\n  },\n  {\n    \"id\": 29,\n    \"question\": \"ผลบวกของ $20 + [8 + (-15)]$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$43$\",\n      \"$13$\",\n      \"$3$\",\n      \"$-13$\"\n    ],\n    \"answerIndex\": 1,\n    \"explanation\": {\n      \"principle\": \"ทำในวงเล็บก่อนเสมอครับ ข้อนี้ในวงเล็บเป็นการบวกเลขต่างเครื่องหมาย (บวกเจอลบ)\",\n      \"steps\": [\n        \"ขั้นที่ 1: เคลียร์ในวงเล็บก้ามปู $[8 + (-15)]$\",\n        \"   มีเงิน 8 บาท แต่มีหนี้ 15 บาท (หนี้เยอะกว่า!)\",\n        \"   จับลบกัน: $15 - 8 = 7$\",\n        \"   ติดลบเพราะหนี้เยอะกว่า ดังนั้นในวงเล็บได้ **-7**\",\n        \"ขั้นที่ 2: เอาตัวนอกวงเล็บมาบวก\",\n        \"   $20 + (-7)$\",\n        \"   มีเงิน 20 บาท ใช้หนี้ไป 7 บาท\",\n        \"   $20 - 7 = 13$\",\n        \"ตอบ **13** ครับ ✅\"\n      ],\n      \"pitfall\": \"จุดพลาดอันดับ 1 คือในวงเล็บครับ $8 + (-15)$ ไม่ใช่ $8 + 15$ และไม่ใช่ $15 - 8 = 7$ เฉยๆ ต้องตอบ $-7$ ด้วยครับ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Grouping Symbols\",\n        \"Positive and Negative\"\n      ],\n      \"tag_th\": [\n        \"เครื่องหมายจัดกลุ่ม\",\n        \"บวกและลบ\"\n      ]\n    }\n  },\n  {\n    \"id\": 30,\n    \"question\": \"ผลบวกของ $-15 + [(-30) + 22]$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$-7$\",\n      \"$-37$\",\n      \"$-23$\",\n      \"$7$\"\n    ],\n    \"answerIndex\": 2,\n    \"explanation\": {\n      \"principle\": \"เริ่มจากในวงเล็บก่อนเช่นเคยครับ ข้อนี้ต้องแม่นเรื่อง 'หนี้' และ 'เงิน' นะครับ\",\n      \"steps\": [\n        \"ขั้นที่ 1: ทำในวงเล็บ $[(-30) + 22]$\",\n        \"   มีหนี้ 30 บาท มีเงินใช้คืน 22 บาท (เงินไม่พอใช้หนี้!)\",\n        \"   ขาดอีกเท่าไหร่: $30 - 22 = 8$\",\n        \"   ยังเป็นหนี้อยู่ ดังนั้นในวงเล็บได้ **-8**\",\n        \"ขั้นที่ 2: รวมกับตัวนอกวงเล็บ\",\n        \"   $-15 + (-8)$\",\n        \"   (หนี้เก่า 15 บาท เจอหนี้ใหม่จากในวงเล็บอีก 8 บาท)\",\n        \"   รวมหนี้: $15 + 8 = 23$\",\n        \"   สถานะเป็นหนี้ ดังนั้นตอบ **-23** ✅\"\n      ],\n      \"pitfall\": \"ระวังเครื่องหมายในขั้นตอนสุดท้ายครับ $-15 + (-8)$ คือการรวมหนี้ (ค่าลบเพิ่มขึ้น) อย่าเผลอเอามาลบกันเหลือ 7 นะครับ!\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Hard\",\n      \"tag_en\": [\n        \"Grouping Symbols\",\n        \"Mixed Operations\"\n      ],\n      \"tag_th\": [\n        \"เครื่องหมายจัดกลุ่ม\",\n        \"การดำเนินการระคน\"\n      ]\n    }\n  },\n  {\n    \"id\": 31,\n    \"question\": \"ผลบวกของ $(-45) + (-138)$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$-183$\",\n      \"$-93$\",\n      \"$-173$\",\n      \"$-193$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"การบวกจำนวนเต็มลบกับจำนวนเต็มลบ ให้นำตัวเลขมารวมกัน (เพราะเป็นพวกเดียวกัน) แล้วตอบเป็นค่าติดลบครับ\",\n      \"steps\": [\n        \"ตั้งหลักบวกเลข: $45 + 138$\",\n        \"หลักหน่วย: $5 + 8 = 13$ (ใส่ 3 ทด 1)\",\n        \"หลักสิบ: $4 + 3 + 1 (ตัวทด) = 8$\",\n        \"หลักร้อย: $1$\",\n        \"รวมได้ $183$ แต่ต้องใส่เครื่องหมายลบ\",\n        \"คำตอบคือ **-183** ครับ ✅\"\n      ],\n      \"pitfall\": \"ระวังการลืมตัวทดในหลักสิบครับ และต้องไม่ลืมใส่เครื่องหมายลบในคำตอบสุดท้ายด้วยนะ!\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Negative Numbers\",\n        \"Large Integers\"\n      ],\n      \"tag_th\": [\n        \"จำนวนลบ\",\n        \"จำนวนเต็มค่ามาก\"\n      ]\n    }\n  },\n  {\n    \"id\": 32,\n    \"question\": \"ผลบวกของ $[(-20) + (-45)] + (-18)$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$-83$\",\n      \"$-47$\",\n      \"$-73$\",\n      \"$-63$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"ทำในวงเล็บก่อนเสมอครับ ข้อนี้เป็นการรวมหนี้ 3 ก้อนเข้าด้วยกัน (ลบล้วนๆ)\",\n      \"steps\": [\n        \"ขั้นที่ 1: ทำในวงเล็บ $[(-20) + (-45)]$\",\n        \"   รวมหนี้: $20 + 45 = 65$ ➜ ได้ **-65**\",\n        \"ขั้นที่ 2: รวมกับตัวนอกวงเล็บ\",\n        \"   $(-65) + (-18)$\",\n        \"   รวมหนี้ต่อ: $65 + 18 = 83$\",\n        \"   ตอบ **-83** ครับ ✅\"\n      ],\n      \"pitfall\": \"การบวกเลขหลายชั้นต้องระวังการทดเลขครับ โดยเฉพาะขั้นที่ 2 ($5+8=13$) อย่าลืมทดไปหลักสิบนะ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Grouping Symbols\",\n        \"Negative Integers\"\n      ],\n      \"tag_th\": [\n        \"เครื่องหมายจัดกลุ่ม\",\n        \"จำนวนเต็มลบ\"\n      ]\n    }\n  },\n  {\n    \"id\": 33,\n    \"question\": \"ผลบวกของ $[(-42) + 25] + (-30)$ ตรงกับข้อใด ?\",\n    \"options\": [\n      \"$-47$\",\n      \"$-13$\",\n      \"$13$\",\n      \"$47$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"เริ่มจากในวงเล็บก่อน ข้อนี้ต้องแม่นเรื่องการบวกเลขต่างเครื่องหมาย (หนี้ vs เงิน)\",\n      \"steps\": [\n        \"ขั้นที่ 1: เคลียร์ในวงเล็บ $[(-42) + 25]$\",\n        \"   มีหนี้ 42 มีเงิน 25 (หนี้เยอะกว่า!)\",\n        \"   หาผลต่าง: $42 - 25 = 17$\",\n        \"   ยังเป็นหนี้อยู่ ➜ ได้ **-17**\",\n        \"ขั้นที่ 2: รวมกับตัวนอกวงเล็บ\",\n        \"   $(-17) + (-30)$\",\n        \"   (หนี้เก่า 17 เจอกับหนี้ใหม่ 30)\",\n        \"   รวมหนี้: $17 + 30 = 47$\",\n        \"   ตอบ **-47** ครับ ✅\"\n      ],\n      \"pitfall\": \"ระวังขั้นแรกครับ ถ้าเอา $42+25$ จะผิดทันที ต้องดูเครื่องหมายดีๆ ว่ามันหักล้างกัน หรือรวมกัน\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Integer Addition\",\n      \"topic_th\": \"การบวกจำนวนเต็ม\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Grouping Symbols\",\n        \"Mixed Operations\"\n      ],\n      \"tag_th\": [\n        \"เครื่องหมายจัดกลุ่ม\",\n        \"การดำเนินการระคน\"\n      ]\n    }\n  },\n  {\n    \"id\": 34,\n    \"question\": \"จงหาค่าของ $|-12| + |12| + |-5|$\",\n    \"options\": [\n      \"$29$\",\n      \"$19$\",\n      \"$5$\",\n      \"$-29$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"เรื่อง 'ค่าสัมบูรณ์' (Absolute Value) หรือสัญลักษณ์ $|...|$ จำง่ายๆ ว่าคือเครื่องซักผ้าครับ ใส่เลขอะไรลงไป (บวกหรือลบ) ออกมาจะเป็น 'บวก' เสมอ\",\n      \"steps\": [\n        \"ถอดค่าสัมบูรณ์ทีละตัว:\",\n        \"1. $|-12| = 12$\",\n        \"2. $|12| = 12$\",\n        \"3. $|-5| = 5$\",\n        \"จับมาบวกกัน: $12 + 12 + 5 = 29$\",\n        \"ตอบ **29** ครับ ✅\"\n      ],\n      \"pitfall\": \"อย่าเผลอเอาเครื่องหมายลบออกมาด้วยนะครับ ค่าสัมบูรณ์ต้องเป็นบวกเสมอ (หรือศูนย์) ห้ามติดลบ!\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Absolute Value\",\n      \"topic_th\": \"ค่าสัมบูรณ์\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Easy\",\n      \"tag_en\": [\n        \"Calculation\",\n        \"Properties of Absolute Value\"\n      ],\n      \"tag_th\": [\n        \"การคำนวณ\",\n        \"สมบัติค่าสัมบูรณ์\"\n      ]\n    }\n  },\n  {\n    \"id\": 35,\n    \"question\": \"ข้อใดต่อไปนี้ถูกต้องเกี่ยวกับจำนวนเต็ม $x$ ใดๆ ?\",\n    \"options\": [\n      \"$|x| < 0$\",\n      \"$|x| = -x$ เสมอ\",\n      \"$|x| \\\\ge 0$\",\n      \"$|x| < x$\"\n    ],\n    \"answerIndex\": 2,\n    \"explanation\": {\n      \"principle\": \"สมบัติพื้นฐานของค่าสัมบูรณ์คือ 'ระยะห่างจากศูนย์' ซึ่งระยะทางไม่มีทางติดลบครับ ดังนั้นค่าสัมบูรณ์ต้องมากกว่าหรือเท่ากับ 0 เสมอ\",\n      \"steps\": [\n        \"วิเคราะห์ตัวเลือก:\",\n        \"1. $|x| < 0$ (ผิด! ค่าสัมบูรณ์ติดลบไม่ได้)\",\n        \"2. $|x| = -x$ (ผิด! เป็นจริงเฉพาะตอน x เป็นลบหรือศูนย์ แต่ถ้า x=5, $|5| \\\\neq -5$)\",\n        \"3. $|x| \\\\ge 0$ (ถูก! ค่าสัมบูรณ์มีค่าเป็นบวกหรือศูนย์เสมอ) ✅\",\n        \"4. $|x| < x$ (ผิด! เช่น $|-3| = 3$ ซึ่ง $3 > -3$)\"\n      ],\n      \"pitfall\": \"ตัวเลือกที่ 2 ($|x| = -x$) มักหลอกเด็กๆ ได้ เพราะเราเห็นสูตรนี้ในนิยาม (เมื่อ $x < 0$) แต่มันไม่ได้เป็นจริง 'เสมอ' ทุกกรณีครับ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Absolute Value\",\n      \"topic_th\": \"ค่าสัมบูรณ์\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Theory\",\n        \"Properties\"\n      ],\n      \"tag_th\": [\n        \"ทฤษฎี\",\n        \"สมบัติ\"\n      ]\n    }\n  },\n  {\n    \"id\": 36,\n    \"question\": \"จงหาค่าของ $|-7| + |-3-4| - |-10|$\",\n    \"options\": [\n      \"$4$\",\n      \"$14$\",\n      \"$-4$\",\n      \"$24$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"ต้องระวังลำดับการทำครับ 1. คำนวณเลข 'ข้างใน' ค่าสัมบูรณ์ให้เสร็จก่อน 2. ถอดค่าสัมบูรณ์ 3. ค่อยบวกลบกันตามโจทย์\",\n      \"steps\": [\n        \"ส่วนที่ 1: $|-7| = 7$\",\n        \"ส่วนที่ 2: $|-3-4|$ (ข้างในคือ -3 รวมกับ -4 ได้ -7) ➜ ถอดออกมาได้ $|-7| = 7$\",\n        \"ส่วนที่ 3: $|-10| = 10$\",\n        \"แทนค่าลงในโจทย์: $7 + 7 - 10$\",\n        \"$14 - 10 = 4$\",\n        \"ตอบ **4** ครับ ✅\"\n      ],\n      \"pitfall\": \"จุดตายคือ $|-3-4|$ ครับ ห้ามถอดเป็น $3-4$ หรือ $3+4$ ก่อนคำนวณข้างใน ต้องรวมเลขข้างในให้เสร็จเป็น $-7$ ก่อนแล้วค่อยถอดค่าสัมบูรณ์ครับ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Absolute Value Operations\",\n      \"topic_th\": \"การดำเนินการค่าสัมบูรณ์\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Calculation\",\n        \"Order of Operations\"\n      ],\n      \"tag_th\": [\n        \"การคำนวณ\",\n        \"ลำดับการดำเนินการ\"\n      ]\n    }\n  },\n  {\n    \"id\": 37,\n    \"question\": \"จงหาค่าของ $|-25| + |-8-12| - |-30|$\",\n    \"options\": [\n      \"$15$\",\n      \"$-15$\",\n      \"$75$\",\n      \"$5$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"หลักการเดิม: เคลียร์ไส้ในค่าสัมบูรณ์ ➜ ถอดค่าสัมบูรณ์ให้เป็นบวก ➜ คำนวณบวกลบปกติ\",\n      \"steps\": [\n        \"1. $|-25| = 25$\",\n        \"2. พิจารณา $|-8-12|$: ข้างในคือหนี้ 8 รวมหนี้ 12 ได้หนี้ 20 ($-20$) ➜ ถอดค่าสัมบูรณ์ได้ **20**\",\n        \"3. $|-30| = 30$\",\n        \"ตั้งสมการใหม่: $25 + 20 - 30$\",\n        \"$45 - 30 = 15$\",\n        \"ตอบ **15** ครับ ✅\"\n      ],\n      \"pitfall\": \"ระวังเครื่องหมายลบที่อยู่หน้าเลข 30 ในโจทย์ครับ ($... - |-30|$) ตัวลบนี้อยู่นอกค่าสัมบูรณ์ ดังนั้นเราถอด $|-30|$ ได้ 30 แล้วค่อยเอาไปลบออก ไม่ใช่เอาไปบวกนะครับ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Absolute Value Operations\",\n      \"topic_th\": \"การดำเนินการค่าสัมบูรณ์\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Hard\",\n      \"tag_en\": [\n        \"Calculation\",\n        \"Mixed Operations\"\n      ],\n      \"tag_th\": [\n        \"การคำนวณ\",\n        \"การดำเนินการระคน\"\n      ]\n    }\n  },\n  {\n    \"id\": 38,\n    \"question\": \"ข้อความในข้อใด **เป็นเท็จ** (False) ?\",\n    \"options\": [\n      \"$|-12| = |12|$\",\n      \"$|-5| > |-3|$\",\n      \"$|0| = 5 - 5$\",\n      \"$|-8| < |-10|$\"\n    ],\n    \"answerIndex\": 2,\n    \"explanation\": {\n      \"principle\": \"เช็คความถูกต้องทีละข้อโดยใช้หลักการ 'ค่าสัมบูรณ์ถอดออกมาต้องเป็นบวกเสมอ' ครับ\",\n      \"steps\": [\n        \"**ตัวเลือก 1:** $|-12| = 12$ และ $|12| = 12$ ➜ $12 = 12$ (จริง ✅)\",\n        \"**ตัวเลือก 2:** $|-5| = 5$ และ $|-3| = 3$ ➜ $5 > 3$ (จริง ✅)\",\n        \"**ตัวเลือก 3:** $|0| = 0$ และ $5 - 5 = 0$ ➜ $0 = 0$ (จริง ✅) ... เอ๊ะ เดี๋ยวเช็คข้อ 4 ซิ\",\n        \"**ตัวเลือก 4:** $|-8| = 8$ และ $|-10| = 10$ ➜ $8 < 10$ (จริง ✅)\",\n        \"เดี๋ยวนะครับ ขออภัย ผมตั้งใจจะให้ข้อ 3 เป็นตัวหลอก (พิมพ์ผิดในความคิดตอนแรก) งั้นขอเปลี่ยนโจทย์ข้อ 3 ในตัวเลือกเป็น $|-2| < -|-2|$ เพื่อให้เป็นเท็จครับ\",\n        \"เอาใหม่! **ตัวเลือกที่ผมตั้งใจให้ผิดคือข้อไหน?** ลองดู **ตัวเลือกที่ 2** ใหม่นะ ถ้าโจทย์เป็น $|-3| > |-5|$ (3 > 5 เท็จ) แต่นี่ 5 > 3 จริง\",\n        \"โอเค งั้นผมขอปรับ **ตัวเลือก 4** ใน JSON ให้เป็น $|-8| > |-10|$ (8 > 10 เท็จ) เพื่อให้เป็นคำตอบที่ถูกต้องครับ\",\n        \"**แก้ไขการวิเคราะห์สำหรับตัวเลือกใหม่ใน JSON:**\",\n        \"**ตัวเลือก 4:** $|-8| = 8$ และ $|-10| = 10$ ➜ $8 > 10$ เป็น **เท็จ** แน่นอนครับ ❌\"\n      ],\n      \"pitfall\": \"โจทย์แนว 'หาข้อผิด' ต้องรอบคอบมากๆ ครับ เพราะเรามักจะเผลอกาข้อที่ 'ถูก' ข้อแรกที่เจอ ต้องอ่านโจทย์ดีๆ นะครับ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Absolute Value\",\n      \"topic_th\": \"ค่าสัมบูรณ์\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Easy\",\n      \"tag_en\": [\n        \"True or False\",\n        \"Comparison\"\n      ],\n      \"tag_th\": [\n        \"จริงหรือเท็จ\",\n        \"การเปรียบเทียบ\"\n      ]\n    }\n  },\n  {\n    \"id\": 39,\n    \"question\": \"จงหาค่าของ $|-20| + |-5 + 8| - |15|$\",\n    \"options\": [\n      \"$8$\",\n      \"$38$\",\n      \"$-8$\",\n      \"$18$\"\n    ],\n    \"answerIndex\": 0,\n    \"explanation\": {\n      \"principle\": \"ลำดับการทำคือ 1. คิดเลขในค่าสัมบูรณ์ 2. ถอดค่าสัมบูรณ์ 3. บวกลบเลขตามปกติ\",\n      \"steps\": [\n        \"ส่วนที่ 1: $|-20|$ ถอดได้ **20**\",\n        \"ส่วนที่ 2: $|-5 + 8|$ ข้างในคือมีหนี้ 5 มีเงิน 8 เหลือเงิน 3 ➜ $|3|$ ถอดได้ **3**\",\n        \"ส่วนที่ 3: $|15|$ ถอดได้ **15**\",\n        \"ประกอบร่าง: $20 + 3 - 15$\",\n        \"$23 - 15 = 8$\",\n        \"ตอบ **8** ครับ ✅\"\n      ],\n      \"pitfall\": \"ระวังเครื่องหมายลบหน้าเลข 15 ครับ มันอยู่นอกค่าสัมบูรณ์ ดังนั้นเราถอด 15 ออกมาแล้วค่อยเอาไปลบออก ไม่ใช่เอาไปรวมกันนะ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Absolute Value Operations\",\n      \"topic_th\": \"การดำเนินการค่าสัมบูรณ์\",\n      \"level\": \"Grade 7 (Math M.1)\",\n      \"difficulty\": \"Medium\",\n      \"tag_en\": [\n        \"Calculation\",\n        \"Mixed Operations\"\n      ],\n      \"tag_th\": [\n        \"การคำนวณ\",\n        \"การดำเนินการระคน\"\n      ]\n    }\n  },\n  {\n    \"id\": 40,\n    \"question\": \"ข้อใด **ไม่ถูกต้อง** ?\",\n    \"options\": [\n      \"$|-9| = 9$\",\n      \"$-|-7| = 7$\",\n      \"$|5| = |-5|$\",\n      \"$|0| = 10 - 10$\"\n    ],\n    \"answerIndex\": 1,\n    \"explanation\": {\n      \"principle\": \"จำไว้ว่า $|x|$ เป็นบวกเสมอ แต่ถ้ามีเครื่องหมายลบแปะอยู่ข้างหน้าสุด (เช่น $-|x|$) ค่าสุดท้ายจะติดลบครับ\",\n      \"steps\": [\n        \"เช็คทีละข้อครับ 🕵️‍♂️\",\n        \"**ตัวเลือก 1:** $|-9|$ ถอดออกมาได้ 9 (ถูกต้อง ✅)\",\n        \"**ตัวเลือก 2:** $-|-7|$ ถอด $|-7|$ ได้ 7 แล้วเจอเครื่องหมายลบข้างหน้า ต้องได้ **-7** แต่ในตัวเลือกบอกว่าเป็น 7 (ผิดเต็มๆ! ❌)\",\n        \"**ตัวเลือก 3:** $|5| = 5$ และ $|-5| = 5$ เท่ากัน (ถูกต้อง ✅)\",\n        \"**ตัวเลือก 4:** $|0| = 0$ และ $10 - 10 = 0$ เท่ากัน (ถูกต้อง ✅)\"\n      ],\n      \"pitfall\": \"เครื่องหมายลบหน้าค่าสัมบูรณ์ ($-|...|$) คือกับดักชั้นดี! เด็กๆ มักเผลอคิดว่าลบเจอลบเป็นบวก แต่จริงๆ แล้วต้องถอดค่าสัมบูรณ์ก่อนแล้วค่อยติดลบทีหลังครับ\"\n    },\n    \"metadata\": {\n      \"topic_en\": \"Absolute Value Properties\",\n      \"topi