# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
service-account*.json
serviceAccountKey.json

# Local backups created when bulk-compressing static images
public/.backup-images-*/
scripts/_backups/

# ไฟล์ที่สคริปต์เรนเดอร์ออกมา (PDF/PNG) — สร้างใหม่ได้เสมอจากไฟล์ .html ต้นฉบับ
scripts/out/

# Playwright
/playwright-report/
/test-results/

# ไฟล์เช็คลิสต์ที่สร้างอัตโนมัติจากโครงคอร์สใน Firestore (สร้างใหม่ได้ด้วย gen-*.js)
scripts/generated/*-checklist-a4.html
scripts/generated/*-checklist-lesson.html

# สำรองก้อนใหญ่ตอนแก้รูปแบบตัวเลือกคลังข้อสอบ (เก็บในเครื่อง ไม่ต้องขึ้น git)
scripts/exam-maintenance/optfmt/backup/
